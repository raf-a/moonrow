+/*
+  mysql_native_password, built in as it was before 9.0: 9.x builds it only as a plugin
+  loaded from the install folder, which a client kept elsewhere can't find, and then can't
+  log in to MySQL 5.7 servers or to 8.x accounts that use it.
+*/
+static void native_password_sha1(uint8_t *digest, const void *a, size_t a_len, const void *b,
+                                 size_t b_len) {
+  EVP_MD_CTX *context = EVP_MD_CTX_create();
+  EVP_DigestInit_ex(context, EVP_sha1(), nullptr);
+  EVP_DigestUpdate(context, a, a_len);
+  if (b != nullptr) EVP_DigestUpdate(context, b, b_len);
+  EVP_DigestFinal_ex(context, digest, nullptr);
+  EVP_MD_CTX_destroy(context);
+}
+
+/* reply = sha1(password) XOR sha1(scramble, sha1(sha1(password))) */
+static int native_password_auth_client(MYSQL_PLUGIN_VIO *vio, MYSQL *mysql) {
+  uchar *pkt;
+  const int pkt_len = vio->read_packet(vio, &pkt);
+  if (pkt_len < 0) return CR_ERROR;
+  if (pkt_len != SCRAMBLE_LENGTH + 1) return CR_SERVER_HANDSHAKE_ERR;
+  memcpy(mysql->scramble, pkt, SCRAMBLE_LENGTH);
+  mysql->scramble[SCRAMBLE_LENGTH] = 0;
+  if (!mysql->passwd[0]) return vio->write_packet(vio, nullptr, 0) ? CR_ERROR : CR_OK;
+  uint8_t stage1[20], stage2[20], reply[SCRAMBLE_LENGTH];
+  native_password_sha1(stage1, mysql->passwd, strlen(mysql->passwd), nullptr, 0);
+  native_password_sha1(stage2, stage1, sizeof stage1, nullptr, 0);
+  native_password_sha1(reply, pkt, SCRAMBLE_LENGTH, stage2, sizeof stage2);
+  for (int i = 0; i < SCRAMBLE_LENGTH; i++) reply[i] ^= stage1[i];
+  return vio->write_packet(vio, reply, SCRAMBLE_LENGTH) ? CR_ERROR : CR_OK;
+}
+
+static auth_plugin_t native_password_client_plugin = {
